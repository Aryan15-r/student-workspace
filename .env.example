# Environment variables for StudySpace
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get a free key from: aistudio.google.com
# NOTE: For production, move this to a Supabase Edge Function environment variable.
#       For the hackathon prototype, keeping it here is acceptable.
GEMINI_API_KEY=your-gemini-api-key-here
