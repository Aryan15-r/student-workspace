{
  "buildCommand": "bash vercel_build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/flowchart",
      "destination": "/flowchart/interactive_flowchart.html"
    },
    {
      "source": "/flowchart.html",
      "destination": "/flowchart/interactive_flowchart.html"
    },
    {
      "source": "/flowchart/(.*)",
      "destination": "/flowchart/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
